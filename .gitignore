# Unity / C#
# Keep the repo clean by ignoring generated Unity folders and IDE/build artifacts.

# Unity Web build output (produced locally and in CI, never committed)
/web/game/

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emory[Cc]aptures/

# Unity generated (can appear in project root)
/il2cppOutput/
/ExportedObj/

# Autogenerated VS / MonoDevelop / Rider files
.vs/
.vscode/
.idea/
.claude
*.iml

# Visual Studio / MSBuild / MonoDevelop
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# Python Backend
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
.env
*.md
!week*

# Corresponding meta files for some ignored IDE artifacts
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt

# Optional: Unity package exports / build outputs
*.unitypackage
*.apk
*.aab
*.ipa

# OS junk
.DS_Store
